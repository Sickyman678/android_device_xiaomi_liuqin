<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tracked copy of the Lindroid local_manifest. To use, copy to
  .repo/local_manifests/lindroid.xml then `repo sync` the projects.
  See ROADMAP.md in this dir for the A16 forward-port status.

  Points at the Sickyman678 Lindroid-a16 forks that carry the A16
  forward-port. external/libhybris + external/lxc are unmodified upstream
  (the A16 libhybris Android.mk denylist is handled by an allowlist in
  vendor/extra, so no libhybris fork is needed). frameworks/native is
  overridden for the single EventHub device.disabled cherry-pick.
-->
<manifest>
  <project path="vendor/lindroid"    name="Sickyman678/vendor_lindroid" remote="github" revision="Lindroid-a16" />
  <project path="vendor/extra"       name="Sickyman678/vendor_extra"    remote="github" revision="Lindroid-a16" />
  <project path="external/libhybris" name="Linux-on-droid/libhybris"    remote="github" revision="lindroid-21" />
  <project path="external/lxc"       name="Linux-on-droid/external_lxc" remote="github" revision="lindroid-21" />

  <remove-project name="LineageOS/android_frameworks_native" />
  <project path="frameworks/native"  name="Sickyman678/android_frameworks_native" remote="github" revision="Lindroid-a16" />
</manifest>
