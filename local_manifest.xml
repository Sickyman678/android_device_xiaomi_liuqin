<?xml version="1.0" encoding="UTF-8"?>
<!--
  Liuqin local manifest for Evolution X (Android 17 / cnb).

  Pulls the device tree plus the liuqin vendor blobs. Everything else
  (sm8450-common device tree, prebuilt kernel, kernel source, modules,
  devicetrees, hardware/xiaomi) is auto-pulled from evolution.dependencies
  when you run `breakfast` -- Evolution X's roomservice reads
  evolution.dependencies, not lineage.dependencies.

  After copying this to .repo/local_manifests/liuqin.xml, run:

      breakfast lineage_liuqin

  to let roomservice resolve transitive deps, then `repo sync -j8`.

  NOTE: the lineage_ product prefix is intentional and must not be renamed.
  Evolution X derives LINEAGE_BUILD by stripping "lineage_" from the product
  name (vendor/lineage/build/envsetup.sh); an evolution_ prefix would leave it
  empty and break the version string, breakfast/brunch and the device check.
-->
<manifest>
  <remote name="sicky" fetch="https://github.com/Sickyman678/" revision="EvolutionX-A17" />

  <!-- Liuqin device tree -->
  <project name="android_device_xiaomi_liuqin" path="device/xiaomi/liuqin" remote="sicky" />

  <!-- Common Xiaomi sm8450 vendor blobs (fork of TheMuppets, liuqin fixes). -->
  <project name="proprietary_vendor_xiaomi_sm8450-common" path="vendor/xiaomi/sm8450-common" remote="sicky" />

  <!-- Liuqin-specific vendor blobs (touch firmware, panel calibration,
       stylus, Adreno a730 firmware, Dolby Vision codecs, camera tuning).
       Extracted from stock OS3.0.5.0.VMYCNXM (Android 15, CN). -->
  <project name="proprietary_vendor_xiaomi_liuqin" path="vendor/xiaomi/liuqin" remote="sicky" />

  <!-- EvoX vendor fork: carries the fix making ro.setupwizard.rotation_locked
       an optional prop, so device.mk below can override it to false. Upstream
       hardcodes it to true via a conditional on PRODUCT_CHARACTERISTICS that
       can never match, which collides with our tablet setting and aborts the
       build on a duplicate sysprop assignment. -->
  <remove-project name="vendor_pixel-style" />
  <project name="vendor_pixel-style" path="vendor/pixel-style" remote="sicky" />
</manifest>
