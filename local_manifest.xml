<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="lossantospro" fetch="https://github.com/LosSantosPro/" revision="lineage-23.2" />
  <remote name="xiaomi-sm8475" fetch="https://github.com/Xiaomi-SM8475/" revision="vauxite" />
  <remote name="aospa" fetch="https://github.com/AOSPA/" revision="vauxite" />
  <remote name="lineage" fetch="https://github.com/LineageOS/" revision="lineage-23.2" />

  <!-- Device, vendor, and kernel trees -->
  <project name="android_device_xiaomi_liuqin" path="device/xiaomi/liuqin" remote="lossantospro" />
  <project name="android_vendor_xiaomi_liuqin" path="vendor/xiaomi/liuqin" remote="lossantospro" revision="vauxite" />
  <project name="android_device_xiaomi_liuqin-kernel" path="device/xiaomi/liuqin-kernel" remote="lossantospro" revision="vauxite" />

  <!-- Common Xiaomi sepolicy (from AOSPA, generic; works with LOS) -->
  <project name="android_device_xiaomi_sepolicy" path="device/xiaomi/sepolicy" remote="aospa" />

  <!-- hardware/xiaomi and hardware/qcom/wlan are provided by either
       LineageOS upstream or another local manifest. If they aren't
       already in your tree, add this to a separate local manifest:
         <remote name="lineage" fetch="https://github.com/LineageOS/" revision="lineage-23.2" />
         <project name="LineageOS/android_hardware_xiaomi" path="hardware/xiaomi" remote="lineage" />
         <project name="LineageOS/android_hardware_qcom_wlan" path="hardware/qcom/wlan" remote="lineage" /> -->
</manifest>
