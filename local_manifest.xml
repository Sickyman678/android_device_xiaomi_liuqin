<?xml version="1.0" encoding="UTF-8"?>
<!--
  Liuqin local manifest. Pulls the device tree itself plus the
  TheMuppets blobs for sm8450-common. Everything else (sm8450-common
  device tree, kernel, kernel modules, devicetrees, hardware/xiaomi)
  is auto-pulled via lineage.dependencies when you run `breakfast`.

  After copying this to .repo/local_manifests/liuqin.xml, run:

      breakfast lineage_liuqin

  to let roomservice resolve transitive deps, then `repo sync -j8`.
-->
<manifest>
  <remote name="lossantospro" fetch="https://github.com/LosSantosPro/" revision="lineage-23.2" />
  <remote name="muppets" fetch="https://github.com/TheMuppets/" revision="lineage-23.2" />

  <!-- Liuqin device tree -->
  <project name="android_device_xiaomi_liuqin" path="device/xiaomi/liuqin" remote="lossantospro" />

  <!-- Common Xiaomi sm8450 vendor blobs from TheMuppets (LineageOS official). -->
  <project name="proprietary_vendor_xiaomi_sm8450-common" path="vendor/xiaomi/sm8450-common" remote="muppets" />

  <!-- vendor/xiaomi/liuqin (device-specific blobs: touch fw, panel cal,
       stylus, etc.) is NOT pulled here because TheMuppets does not yet
       publish a liuqin blob repo. To get full hardware functionality you
       need to extract from a stock Xiaomi Pad 6 Pro firmware dump:

           cd device/xiaomi/liuqin
           ./extract-files.py <path-to-stock-dump>

       Without it the build still completes - just missing some
       liuqin-specific hardware features. -->
</manifest>
