// Note: init.target.rc, fstab.qcom and ueventd.xiaomi.rc are provided
// by device/xiaomi/sm8450-common at the same install paths, so the
// liuqin-tree variants are intentionally not registered here. Only
// keep modules that don't conflict.
//

prebuilt_etc {
    name: "init.mi_perf.rc",
    src: "init.mi_perf.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.mi_service.rc",
    src: "init.mi_service.rc",
    sub_dir: "init/hw",
    vendor: true,
}
