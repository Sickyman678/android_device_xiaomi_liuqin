# Fingerprint paths, fpdump type, mac_addr, nv_mac and the
# fingerprint-service.xiaomi binary are all already declared in
# device/xiaomi/sm8450-common/sepolicy/vendor/file_contexts. Re-declaring
# them here causes file_contexts.device.sorted.tmp generation to fail
# with "Multiple [same|different] specifications". Keep only the
# liuqin-specific Listen-Audio-Service wakeup node.

# Wakeup Nodes
/sys/devices/platform/soc/soc:qcom,msm-audio-apr/soc:qcom,msm-audio-apr:qcom,q6core-audio/soc:qcom,msm-audio-apr:qcom,q6core-audio:sound/Listen\s[0-9]+\sAudio\sService/wakeup/wakeup[0-9]+(/.*)? u:object_r:sysfs_wakeup:s0
